# Provider: ollama (local default) or openai_compat (an open-weight model server)
LLM_PROVIDER=ollama
BASE_URL=http://localhost:11434
MODEL_NAME=gemma3:4b
# Required only for authenticated OpenAI-compatible endpoints; keep this secret out of Git.
API_KEY=

# Set true for a hosted demo that does not need a model server.
DEMO_MODE=false
RATE_LIMIT_PER_HOUR=20
REQUEST_TIMEOUT_S=120
MAX_UPLOAD_MB=8
APP_ENV=development
